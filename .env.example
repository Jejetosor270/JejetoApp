# Runtime PostgreSQL connection. On Vercel, use the provider's pooled URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Optional direct (non-pooled) URL used by Prisma migrations and seeding.
# Recommended for serverless providers such as Neon or Supabase.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

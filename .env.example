# Runtime PostgreSQL connection. On Vercel, use the provider's pooled URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Optional direct (non-pooled) URL used by Prisma migrations and seeding.
# Recommended for serverless providers such as Neon or Supabase.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Required by Auth.js to encrypt employee sessions. Generate with: npm exec auth secret
AUTH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"

# Used once by `npm run users:bootstrap-admin` after deploying the Phase 2 migration.
# Keep the actual values only in your local shell or a secure environment manager.
# BOOTSTRAP_ADMIN_NAME="MB Administrator"
# BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
# BOOTSTRAP_ADMIN_PASSWORD="use-a-unique-password-of-at-least-12-characters"

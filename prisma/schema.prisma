generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MANAGER
  USER
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum ProcurementOrderStatus {
  DRAFT
  QUOTED
  APPROVED
  ORDERED
  DEPOSIT_DUE
  DEPOSIT_PAID
  IN_PRODUCTION
  READY
  BALANCE_DUE
  PAID
  IN_TRANSIT
  DELIVERED
  CLOSED
  CANCELLED
}

enum PricingMode {
  SELLING_PRICE
  TARGET_MARGIN
}

enum ProcurementCostCategory {
  SUPPLIER_PURCHASE
  FREIGHT
  CUSTOMS_DUTIES
  MISCELLANEOUS
}

enum FreightTreatment {
  INCLUDED_IN_PACKAGE_PRICE
  RECHARGED_SEPARATELY
  NOT_APPLICABLE
}

enum VatTreatment {
  DOMESTIC
  INTRA_EU_SUPPLY
  INTRA_EU_ACQUISITION
  REVERSE_CHARGE
  EXPORT
  IMPORT
  EXEMPT
  OUT_OF_SCOPE
  CUSTOM
}

enum VatDirection {
  INPUT
  OUTPUT
}

enum VatRecoverability {
  RECOVERABLE
  NON_RECOVERABLE
}

enum PaymentDirection {
  SUPPLIER_PAYMENT
  CLIENT_RECEIPT
}

enum InstallmentBasis {
  PERCENTAGE
  FIXED_AMOUNT
}

enum SupplierQuoteImportAction {
  CREATED_ORDER
  UPDATED_ORDER
}

enum ItemCommercialStatus {
  BUDGET
  QUOTED
  SELECTED
  ORDERED
  CANCELLED
}

enum ItemLogisticsStatus {
  PENDING
  IN_PRODUCTION
  IN_TRANSIT
  RECEIVED_FABRICATOR
  RECEIVED_WAREHOUSE
  DELIVERED_RESIDENCE
  INSTALLED
  CLAIM
}

enum LogisticsLocationType {
  WAREHOUSE
  FABRICATOR
  PROJECT_SITE
  OTHER
}

enum ItemSourceType {
  MANUAL
  BUDGET_XLSX
  SUPPLIER_QUOTE_PDF
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(160)
  email        String   @unique @db.VarChar(320)
  /// Nullable only for historical, pre-authentication records. Such records are inactive
  /// and cannot establish an employee session.
  passwordHash String?  @db.VarChar(255)
  authSubject  String?  @unique @db.VarChar(255)
  role         UserRole @default(USER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdById  String?  @db.Uuid
  updatedById  String?  @db.Uuid

  createdBy User? @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("UserUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdUsers User[] @relation("UserCreatedBy")
  updatedUsers User[] @relation("UserUpdatedBy")

  managedProjects Project[] @relation("ProjectManager")

  createdClients             Client[]                   @relation("ClientCreatedBy")
  updatedClients             Client[]                   @relation("ClientUpdatedBy")
  createdSuppliers           Supplier[]                 @relation("SupplierCreatedBy")
  updatedSuppliers           Supplier[]                 @relation("SupplierUpdatedBy")
  createdProjects            Project[]                  @relation("ProjectCreatedBy")
  updatedProjects            Project[]                  @relation("ProjectUpdatedBy")
  createdBuildings           Building[]                 @relation("BuildingCreatedBy")
  updatedBuildings           Building[]                 @relation("BuildingUpdatedBy")
  createdOrders              ProcurementOrder[]         @relation("ProcurementOrderCreatedBy")
  updatedOrders              ProcurementOrder[]         @relation("ProcurementOrderUpdatedBy")
  linkedOrderBuildings       ProcurementOrderBuilding[] @relation("OrderBuildingCreatedBy")
  createdCostLines           ProcurementOrderCostLine[] @relation("CostLineCreatedBy")
  updatedCostLines           ProcurementOrderCostLine[] @relation("CostLineUpdatedBy")
  createdVatEntries          ProcurementOrderVatEntry[] @relation("VatEntryCreatedBy")
  updatedVatEntries          ProcurementOrderVatEntry[] @relation("VatEntryUpdatedBy")
  createdPaymentInstallments PaymentInstallment[]       @relation("PaymentInstallmentCreatedBy")
  updatedPaymentInstallments PaymentInstallment[]       @relation("PaymentInstallmentUpdatedBy")
  createdPaymentSettlements  PaymentSettlement[]        @relation("PaymentSettlementCreatedBy")
  updatedPaymentSettlements  PaymentSettlement[]        @relation("PaymentSettlementUpdatedBy")
  processedSupplierQuotes    SupplierQuoteImport[]       @relation("SupplierQuoteImportProcessedBy")
  auditEvents                AuditEvent[]                 @relation("AuditEventActor")
  createdApplicationSettings ApplicationSetting[]        @relation("ApplicationSettingCreatedBy")
  updatedApplicationSettings ApplicationSetting[]        @relation("ApplicationSettingUpdatedBy")
  createdRooms               Room[]                       @relation("RoomCreatedBy")
  updatedRooms               Room[]                       @relation("RoomUpdatedBy")
  createdLogisticsLocations  LogisticsLocation[]          @relation("LogisticsLocationCreatedBy")
  updatedLogisticsLocations  LogisticsLocation[]          @relation("LogisticsLocationUpdatedBy")
  createdItems               Item[]                       @relation("ItemCreatedBy")
  updatedItems               Item[]                       @relation("ItemUpdatedBy")
  itemImports                ItemImport[]                 @relation("ItemImportImportedBy")

  @@index([isActive])
  @@map("users")
}

model Currency {
  code       String   @id @db.Char(3)
  name       String   @db.VarChar(80)
  minorUnits Int      @default(2)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  clients       Client[]           @relation("ClientDefaultCurrency")
  suppliers     Supplier[]         @relation("SupplierDefaultCurrency")
  projects      Project[]          @relation("ProjectReportingCurrency")
  orders        ProcurementOrder[] @relation("OrderCurrency")
  sellingOrders ProcurementOrder[] @relation("OrderSellingCurrency")

  paymentInstallments PaymentInstallment[]
  applicationSettings ApplicationSetting[]
  items               Item[]

  @@index([isActive])
  @@map("currencies")
}

model Client {
  id                  String   @id @default(uuid()) @db.Uuid
  legalName           String   @db.VarChar(200)
  displayName         String   @db.VarChar(160)
  billingAddressLine1 String?  @db.VarChar(200)
  billingAddressLine2 String?  @db.VarChar(200)
  billingCity         String?  @db.VarChar(120)
  billingPostalCode   String?  @db.VarChar(32)
  countryCode         String?  @db.Char(2)
  vatNumber           String?  @db.VarChar(64)
  defaultCurrencyCode String   @db.Char(3)
  contactName         String?  @db.VarChar(160)
  email               String?  @db.VarChar(320)
  phone               String?  @db.VarChar(50)
  notes               String?  @db.Text
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  createdById         String?  @db.Uuid
  updatedById         String?  @db.Uuid

  defaultCurrency Currency  @relation("ClientDefaultCurrency", fields: [defaultCurrencyCode], references: [code], onDelete: Restrict)
  createdBy       User?     @relation("ClientCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy       User?     @relation("ClientUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  projects        Project[]

  @@index([displayName])
  @@index([isActive])
  @@index([isActive, displayName])
  @@index([countryCode])
  @@index([defaultCurrencyCode])
  @@map("clients")
}

model Supplier {
  id                       String   @id @default(uuid()) @db.Uuid
  legalName                String   @db.VarChar(200)
  displayName              String   @db.VarChar(160)
  addressLine1             String?  @db.VarChar(200)
  addressLine2             String?  @db.VarChar(200)
  city                     String?  @db.VarChar(120)
  postalCode               String?  @db.VarChar(32)
  countryCode              String?  @db.Char(2)
  vatNumber                String?  @db.VarChar(64)
  defaultCurrencyCode      String   @db.Char(3)
  defaultPaymentTermsNotes String?  @db.VarChar(240)
  contactName              String?  @db.VarChar(160)
  email                    String?  @db.VarChar(320)
  phone                    String?  @db.VarChar(50)
  defaultPaymentTermsDays  Int?
  defaultLeadTimeWeeks     Int?
  notes                    String?  @db.Text
  isActive                 Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  createdById              String?  @db.Uuid
  updatedById              String?  @db.Uuid

  defaultCurrency Currency           @relation("SupplierDefaultCurrency", fields: [defaultCurrencyCode], references: [code], onDelete: Restrict)
  createdBy       User?              @relation("SupplierCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy       User?              @relation("SupplierUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  orders          ProcurementOrder[]
  quoteImports    SupplierQuoteImport[]
  items           Item[]
  itemImports     ItemImport[]

  @@index([displayName])
  @@index([isActive])
  @@index([isActive, displayName])
  @@index([countryCode])
  @@index([defaultCurrencyCode])
  @@map("suppliers")
}

model Project {
  id                     String        @id @default(uuid()) @db.Uuid
  name                   String        @db.VarChar(200)
  code                   String        @unique @db.VarChar(40)
  clientId               String        @db.Uuid
  countryCode            String?       @db.Char(2)
  reportingCurrencyCode  String        @db.Char(3)
  projectManagerId       String?       @db.Uuid
  startDate              DateTime?     @db.Date
  expectedCompletionDate DateTime?     @db.Date
  status                 ProjectStatus @default(PLANNING)
  notes                  String?       @db.Text
  freightEstimateRate    Decimal?      @db.Decimal(9, 6)
  freightEstimateNotes   String?       @db.VarChar(500)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  createdById            String?       @db.Uuid
  updatedById            String?       @db.Uuid

  client            Client             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  reportingCurrency Currency           @relation("ProjectReportingCurrency", fields: [reportingCurrencyCode], references: [code], onDelete: Restrict)
  projectManager    User?              @relation("ProjectManager", fields: [projectManagerId], references: [id], onDelete: SetNull)
  createdBy         User?              @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy         User?              @relation("ProjectUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  buildings         Building[]
  orders            ProcurementOrder[]
  quoteImports      SupplierQuoteImport[]
  items             Item[]
  itemImports       ItemImport[]

  @@index([clientId])
  @@index([projectManagerId])
  @@index([status])
  @@index([status, name])
  @@index([clientId, status])
  @@map("projects")
}

model Building {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @db.Uuid
  name        String   @db.VarChar(160)
  shortCode   String   @db.VarChar(32)
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid

  project   Project                    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  createdBy User?                      @relation("BuildingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?                      @relation("BuildingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  orders    ProcurementOrderBuilding[]
  rooms     Room[]
  items     Item[]

  @@unique([projectId, shortCode])
  @@index([projectId, isActive])
  @@map("buildings")
}

model ProcurementOrder {
  id                                 String                 @id @default(uuid()) @db.Uuid
  orderNumber                        String                 @unique @db.VarChar(50)
  packageName                        String                 @db.VarChar(200)
  description                        String?                @db.Text
  category                           String?                @db.VarChar(80)
  projectId                          String                 @db.Uuid
  supplierId                         String                 @db.Uuid
  orderCurrencyCode                  String                 @db.Char(3)
  supplierQuoteReference             String?                @db.VarChar(120)
  supplierOrderConfirmationReference String?                @db.VarChar(120)
  status                             ProcurementOrderStatus @default(DRAFT)
  freightTreatment                   FreightTreatment       @default(NOT_APPLICABLE)
  pricingMode                        PricingMode            @default(SELLING_PRICE)
  purchaseFxRateToReporting          Decimal?               @db.Decimal(20, 10)
  sellingFxRateToReporting           Decimal?               @db.Decimal(20, 10)
  sellingPriceAmount                 Decimal?               @db.Decimal(19, 4)
  sellingCurrencyCode                String                 @db.Char(3)
  freightResaleAmount                Decimal?               @db.Decimal(19, 4)
  targetMarginRate                   Decimal?               @db.Decimal(9, 6)
  quoteDate                          DateTime?              @db.Date
  orderDate                          DateTime?              @db.Date
  acknowledgementDate                DateTime?              @db.Date
  leadTimeWeeks                      Int?
  expectedReadyDate                  DateTime?              @map("estimatedProductionAt") @db.Date
  actualProductionAt                 DateTime?              @db.Date
  estimatedDispatchAt                DateTime?              @db.Date
  actualDispatchAt                   DateTime?              @db.Date
  expectedDeliveryDate               DateTime?              @map("estimatedDeliveryAt") @db.Date
  actualDeliveryDate                 DateTime?              @map("actualDeliveryAt") @db.Date
  notes                              String?                @db.Text
  createdAt                          DateTime               @default(now())
  updatedAt                          DateTime               @updatedAt
  createdById                        String?                @db.Uuid
  updatedById                        String?                @db.Uuid

  project         Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  supplier        Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  orderCurrency   Currency @relation("OrderCurrency", fields: [orderCurrencyCode], references: [code], onDelete: Restrict)
  sellingCurrency Currency @relation("OrderSellingCurrency", fields: [sellingCurrencyCode], references: [code], onDelete: Restrict)
  createdBy       User?    @relation("ProcurementOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy       User?    @relation("ProcurementOrderUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  buildings           ProcurementOrderBuilding[]
  costLines           ProcurementOrderCostLine[]
  vatEntries          ProcurementOrderVatEntry[]
  paymentInstallments PaymentInstallment[]
  quoteImports        SupplierQuoteImport[]
  items               Item[]
  itemImports         ItemImport[]

  @@index([projectId])
  @@index([supplierId])
  @@index([status])
  @@index([projectId, status])
  @@index([supplierId, status])
  @@index([orderCurrencyCode])
  @@index([updatedAt])
  @@index([expectedDeliveryDate], map: "procurement_orders_estimatedDeliveryAt_idx")
  @@map("procurement_orders")
}

model ProcurementOrderBuilding {
  orderId     String   @db.Uuid
  buildingId  String   @db.Uuid
  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid

  order     ProcurementOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  building  Building         @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  createdBy User?            @relation("OrderBuildingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@id([orderId, buildingId])
  @@index([buildingId])
  @@map("procurement_order_buildings")
}

model ProcurementOrderCostLine {
  id             String                  @id @default(uuid()) @db.Uuid
  orderId        String                  @db.Uuid
  category       ProcurementCostCategory
  description    String?                 @db.VarChar(200)
  originalAmount Decimal                 @db.Decimal(19, 4)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  createdById    String?                 @db.Uuid
  updatedById    String?                 @db.Uuid

  order     ProcurementOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdBy User?            @relation("CostLineCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?            @relation("CostLineUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([orderId, category])
  @@map("procurement_order_cost_lines")
}

model ProcurementOrderVatEntry {
  id                  String             @id @default(uuid()) @db.Uuid
  orderId             String             @db.Uuid
  direction           VatDirection
  treatment           VatTreatment
  recoverability      VatRecoverability?
  countryCode         String?            @db.Char(2)
  customTreatmentNote String?            @db.VarChar(240)
  taxableBaseAmount   Decimal            @db.Decimal(19, 4)
  vatRate             Decimal?           @db.Decimal(9, 6)
  vatAmount           Decimal            @db.Decimal(19, 4)
  isAmountOverride    Boolean            @default(false)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  createdById         String?            @db.Uuid
  updatedById         String?            @db.Uuid

  order     ProcurementOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdBy User?            @relation("VatEntryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?            @relation("VatEntryUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([orderId, direction])
  @@map("procurement_order_vat_entries")
}

model PaymentInstallment {
  id                        String           @id @default(uuid()) @db.Uuid
  orderId                   String           @db.Uuid
  direction                 PaymentDirection
  sequence                  Int
  label                     String           @db.VarChar(200)
  basis                     InstallmentBasis
  percentageRate            Decimal?         @db.Decimal(9, 6)
  scheduledAmount           Decimal          @db.Decimal(19, 4)
  currencyCode              String           @db.Char(3)
  dueDate                   DateTime         @db.Date
  expectedFxRateToReporting Decimal?         @db.Decimal(20, 10)
  isCancelled               Boolean          @default(false)
  notes                     String?          @db.Text
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt
  createdById               String?          @db.Uuid
  updatedById               String?          @db.Uuid

  order       ProcurementOrder    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  currency    Currency            @relation(fields: [currencyCode], references: [code], onDelete: Restrict)
  createdBy   User?               @relation("PaymentInstallmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?               @relation("PaymentInstallmentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  settlements PaymentSettlement[]

  @@unique([orderId, direction, sequence])
  @@index([orderId, direction])
  @@index([direction, dueDate])
  @@index([currencyCode, dueDate])
  @@index([orderId, dueDate])
  @@map("payment_installments")
}

model PaymentSettlement {
  id                String   @id @default(uuid()) @db.Uuid
  installmentId     String   @db.Uuid
  amount            Decimal  @db.Decimal(19, 4)
  settledAt         DateTime @db.Date
  fxRateToReporting Decimal? @db.Decimal(20, 10)
  reference         String?  @db.VarChar(120)
  notes             String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdById       String?  @db.Uuid
  updatedById       String?  @db.Uuid

  installment PaymentInstallment @relation(fields: [installmentId], references: [id], onDelete: Restrict)
  createdBy   User?              @relation("PaymentSettlementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?              @relation("PaymentSettlementUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([installmentId, settledAt])
  @@map("payment_settlements")
}

model SupplierQuoteImport {
  id                     String                    @id @default(uuid()) @db.Uuid
  orderId                String                    @db.Uuid
  projectId              String                    @db.Uuid
  supplierId             String                    @db.Uuid
  originalFilename       String                    @db.VarChar(255)
  supplierQuoteReference String?                   @db.VarChar(120)
  quoteDate              DateTime?                 @db.Date
  leadTimeRaw            String?                   @db.VarChar(500)
  paymentTermsRaw        String?                   @db.Text
  extractionProvider     String                    @db.VarChar(50)
  extractionModel        String                    @db.VarChar(120)
  action                 SupplierQuoteImportAction
  processedAt            DateTime                  @default(now())
  processedById          String?                   @db.Uuid

  order       ProcurementOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  supplier    Supplier         @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  processedBy User?            @relation("SupplierQuoteImportProcessedBy", fields: [processedById], references: [id], onDelete: SetNull)

  @@index([orderId, processedAt])
  @@index([projectId])
  @@index([supplierId])
  @@map("supplier_quote_imports")
}

model AuditEvent {
  id              String   @id @default(uuid()) @db.Uuid
  occurredAt      DateTime @default(now())
  actorId         String?  @db.Uuid
  actorName       String   @db.VarChar(160)
  actorEmail      String   @db.VarChar(320)
  action          String   @db.VarChar(40)
  entityType      String   @db.VarChar(40)
  entityId        String?  @db.VarChar(80)
  entityReference String   @db.VarChar(200)
  summary         String   @db.VarChar(500)
  metadata        Json?

  actor User? @relation("AuditEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([occurredAt])
  @@index([actorId, occurredAt])
  @@index([action, occurredAt])
  @@index([entityType, occurredAt])
  @@map("audit_events")
}

model ApplicationSetting {
  id                           String   @id @default("company") @db.VarChar(40)
  companyName                  String   @db.VarChar(160)
  companyReportingCurrencyCode String   @default("EUR") @db.Char(3)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
  createdById                  String?  @db.Uuid
  updatedById                  String?  @db.Uuid

  companyReportingCurrency Currency @relation(fields: [companyReportingCurrencyCode], references: [code], onDelete: Restrict)
  createdBy                User?    @relation("ApplicationSettingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy                User?    @relation("ApplicationSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("application_settings")
}

model Room {
  id          String   @id @default(uuid()) @db.Uuid
  buildingId  String   @db.Uuid
  name        String   @db.VarChar(160)
  code        String?  @db.VarChar(40)
  notes       String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid

  building  Building @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  createdBy User?    @relation("RoomCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?    @relation("RoomUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  items     Item[]

  @@unique([buildingId, name])
  @@unique([buildingId, code])
  @@index([buildingId, isActive])
  @@map("rooms")
}

model LogisticsLocation {
  id           String                    @id @default(uuid()) @db.Uuid
  name         String                    @db.VarChar(160)
  type         LogisticsLocationType
  addressLine1 String?                   @db.VarChar(200)
  addressLine2 String?                   @db.VarChar(200)
  city         String?                   @db.VarChar(120)
  postalCode   String?                   @db.VarChar(32)
  countryCode  String?                   @db.Char(2)
  notes        String?                   @db.Text
  isActive     Boolean                   @default(true)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  createdById  String?                   @db.Uuid
  updatedById  String?                   @db.Uuid

  createdBy User? @relation("LogisticsLocationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("LogisticsLocationUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  expectedWarehouseItems Item[] @relation("ItemExpectedWarehouse")
  receivedWarehouseItems Item[] @relation("ItemReceivedWarehouse")
  fabricatorItems        Item[] @relation("ItemFabricator")
  destinationItems       Item[] @relation("ItemDestinationLocation")

  @@index([type, isActive])
  @@index([name])
  @@map("logistics_locations")
}

model ItemImport {
  id               String         @id @default(uuid()) @db.Uuid
  projectId        String         @db.Uuid
  supplierId       String?        @db.Uuid
  procurementOrderId String?      @db.Uuid
  sourceType       ItemSourceType
  originalFilename String         @db.VarChar(255)
  importedAt       DateTime       @default(now())
  importedById     String?        @db.Uuid
  rowCount         Int
  createdCount     Int
  updatedCount     Int
  skippedCount     Int
  warningCount     Int
  extractionProvider String?      @db.VarChar(50)
  extractionModel  String?        @db.VarChar(120)
  mappingMetadata  Json?

  project          Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  supplier         Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  procurementOrder ProcurementOrder? @relation(fields: [procurementOrderId], references: [id], onDelete: SetNull)
  importedBy       User?             @relation("ItemImportImportedBy", fields: [importedById], references: [id], onDelete: SetNull)
  items            Item[]

  @@index([projectId, importedAt])
  @@index([supplierId])
  @@index([procurementOrderId])
  @@index([sourceType])
  @@map("item_imports")
}

model Item {
  id                  String               @id @default(uuid()) @db.Uuid
  projectId           String               @db.Uuid
  buildingId          String?              @db.Uuid
  roomId              String?              @db.Uuid
  supplierId          String?              @db.Uuid
  procurementOrderId  String?              @db.Uuid
  importId            String?              @db.Uuid
  sourceType          ItemSourceType       @default(MANUAL)
  sourceSheet         String?              @db.VarChar(120)
  sourceRowNumber     Int?
  sourceReference     String?              @db.VarChar(120)
  itemReference       String?              @db.VarChar(120)
  supplierSku         String?              @db.VarChar(160)
  name                String               @db.VarChar(240)
  description         String?              @db.Text
  category            String?              @db.VarChar(80)
  brand               String?              @db.VarChar(160)
  finishColor         String?              @db.VarChar(240)
  notes               String?              @db.Text
  quantity            Decimal              @default(1) @db.Decimal(19, 4)
  unitOfMeasure       String               @default("EA") @db.VarChar(24)
  weightEach          Decimal?             @db.Decimal(19, 4)
  totalWeight         Decimal?             @db.Decimal(19, 4)
  volumeEach          Decimal?             @db.Decimal(19, 4)
  totalVolume         Decimal?             @db.Decimal(19, 4)
  purchaseCurrencyCode String?             @db.Char(3)
  unitPurchasePriceHt Decimal?              @db.Decimal(19, 4)
  totalPurchasePriceHt Decimal?             @db.Decimal(19, 4)
  pricingMode         PricingMode          @default(SELLING_PRICE)
  targetMarginRate    Decimal?              @db.Decimal(9, 6)
  unitSellingPriceHt  Decimal?              @db.Decimal(19, 4)
  totalSellingPriceHt Decimal?              @db.Decimal(19, 4)
  vatTreatment        VatTreatment?
  vatRecoverability   VatRecoverability?
  vatRate             Decimal?              @db.Decimal(9, 6)
  vatAmount           Decimal?              @db.Decimal(19, 4)
  commercialStatus    ItemCommercialStatus  @default(BUDGET)
  logisticsStatus     ItemLogisticsStatus   @default(PENDING)
  estimatedWarehouseDate DateTime?          @db.Date
  estimatedFabricatorDate DateTime?         @db.Date
  receivedFabricatorDate DateTime?          @db.Date
  receivedWarehouseDate DateTime?           @db.Date
  inTransitDate       DateTime?              @db.Date
  estimatedResidenceDate DateTime?          @db.Date
  deliveredResidenceDate DateTime?          @db.Date
  installedDate       DateTime?              @db.Date
  expectedWarehouseId String?                @db.Uuid
  receivedWarehouseId String?                @db.Uuid
  fabricatorId        String?                @db.Uuid
  destinationLocationId String?              @db.Uuid
  issueDescription    String?                @db.Text
  claimStatus         String?                @db.VarChar(120)
  claimOpenedDate     DateTime?              @db.Date
  claimResolvedDate   DateTime?              @db.Date
  claimNotes          String?                @db.Text
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  createdById         String?                @db.Uuid
  updatedById         String?                @db.Uuid

  project             Project            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  building            Building?           @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  room                Room?               @relation(fields: [roomId], references: [id], onDelete: SetNull)
  supplier            Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  procurementOrder    ProcurementOrder?   @relation(fields: [procurementOrderId], references: [id], onDelete: SetNull)
  itemImport          ItemImport?         @relation(fields: [importId], references: [id], onDelete: SetNull)
  purchaseCurrency    Currency?           @relation(fields: [purchaseCurrencyCode], references: [code], onDelete: Restrict)
  expectedWarehouse   LogisticsLocation?  @relation("ItemExpectedWarehouse", fields: [expectedWarehouseId], references: [id], onDelete: SetNull)
  receivedWarehouse   LogisticsLocation?  @relation("ItemReceivedWarehouse", fields: [receivedWarehouseId], references: [id], onDelete: SetNull)
  fabricator          LogisticsLocation?  @relation("ItemFabricator", fields: [fabricatorId], references: [id], onDelete: SetNull)
  destinationLocation LogisticsLocation?  @relation("ItemDestinationLocation", fields: [destinationLocationId], references: [id], onDelete: SetNull)
  createdBy           User?               @relation("ItemCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy           User?               @relation("ItemUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([buildingId])
  @@index([roomId])
  @@index([supplierId])
  @@index([procurementOrderId])
  @@index([commercialStatus])
  @@index([logisticsStatus])
  @@index([itemReference])
  @@index([supplierSku])
  @@index([importId])
  @@index([projectId, commercialStatus])
  @@index([projectId, updatedAt])
  @@map("items")
}
